# ── Telegram ──────────────────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_from_my_telegram_org
BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_ID=987654321

# ── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=famapp

# ── UPI / Payment ─────────────────────────────────────────
DEFAULT_UPI_ID=yourname@fam
DEFAULT_PAYEE_NAME=Your Name
PURPOSE_PREFIX=FAP
BRAND_NAME=FamApp Pay
ORDER_EXPIRY_MINUTES=15

# ── Gmail IMAP ────────────────────────────────────────────
IMAP_USERNAME=you@gmail.com
IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
IMAP_SENDER_FILTER=no-reply@famapp.in
GMAIL_LOOKBACK_HOURS=12

# ── Support ───────────────────────────────────────────────
SUPPORT_CONTACT=@your_support_username
